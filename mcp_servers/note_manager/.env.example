# Note Manager MCP Server Configuration
# Copy this file to .env and fill in your values

# Database Configuration (Required)
# PostgreSQL connection string with asyncpg driver
# Requires pgvector extension for semantic search
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database

# User Identification (Required)
# The user ID for note operations - set at server startup for security
MCP_USER_ID=

# Google API Key (Required)
# Used for Gemini API access (summarization and embeddings)
GOOGLE_API_KEY=

# Pagination Settings
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=200

# Debug Mode
# Set to true for verbose logging
DEBUG=false
