# Expense Manager MCP Server Configuration
# Copy this file to .env and fill in your values

# Database Configuration (Required)
# PostgreSQL connection string with asyncpg driver
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database

# User Identification (Required)
# The user ID for expense operations - set at server startup for security
MCP_USER_ID=

# Google API Key (Required for AI-powered categorization)
GOOGLE_API_KEY=

# Default Currency
# Used for new expenses when no currency is specified
DEFAULT_CURRENCY=HKD

# Pagination Settings
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=200

# Debug Mode
# Set to true for verbose logging
DEBUG=false
